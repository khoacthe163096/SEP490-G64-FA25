<!-- Welcome Page (Default) -->
<div id="welcome-page" class="page-content active">
    <div class="welcome-container">
        <!-- Header Section -->
        <div class="welcome-header mb-4">
            <h1 class="display-5 fw-normal mb-2">Chào mừng đến với APMMS</h1>
            <p class="text-muted">Hệ thống Quản lý Phụ tùng & Bảo dưỡng Ô tô</p>
        </div>

        <!-- Today's Stats for Directors/Managers -->
        <div class="row mb-4" id="todayStatsSection" style="display: none;">
            <div class="col-md-6 mb-3">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex align-items-center">
                            <div class="flex-shrink-0">
                                <i class="fas fa-money-bill-wave fa-2x text-muted"></i>
                            </div>
                            <div class="flex-grow-1 ms-3">
                                <h6 class="text-muted mb-1 small">Doanh thu hôm nay</h6>
                                <h4 class="mb-0 fw-bold" id="todayRevenue">0 VNĐ</h4>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-6 mb-3">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex align-items-center">
                            <div class="flex-shrink-0">
                                <i class="fas fa-clipboard-list fa-2x text-muted"></i>
                            </div>
                            <div class="flex-grow-1 ms-3">
                                <h6 class="text-muted mb-1 small">Số đơn hàng hôm nay</h6>
                                <h4 class="mb-0 fw-bold" id="todayOrderCount">0</h4>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Today's Schedule Alert -->
        <div class="row mb-4" id="todayScheduleAlert" style="display: none;">
            <div class="col-12">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <h6 class="mb-3 fw-normal">
                            <i class="fas fa-calendar-day me-2 text-muted"></i>
                            Lịch hẹn hôm nay
                        </h6>
                        <p class="mb-2" id="todayScheduleMessage">
                            <i class="fas fa-spinner fa-spin me-2"></i>Đang tải lịch hẹn...
                        </p>
                        <div id="todayScheduleList" class="mt-2"></div>
                        <div class="mt-3">
                            <a href="/ServiceSchedules" class="btn btn-sm btn-outline-secondary">
                                Xem tất cả lịch hẹn
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
